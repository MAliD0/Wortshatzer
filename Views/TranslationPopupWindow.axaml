<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Wortshatzer.ViewModels"
    x:Class="Wortshatzer.Views.TranslationPopupWindow"
    x:DataType="vm:TranslationPopupViewModel"
    Title="Wortshatzer translation"
    Width="420"
    Height="300"
    CanResize="False"
    ShowInTaskbar="False"
    ShowActivated="False"
    Topmost="True"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen"
    Background="#172033"
    CornerRadius="16">

    <Border
        Padding="20"
        BorderBrush="#3A465C"
        BorderThickness="1"
        CornerRadius="16">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel
                    Spacing="2"
                    PointerPressed="DragArea_OnPointerPressed">
                    <TextBlock
                        Text="Wortshatzer"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#AEB9CD"/>
                    <TextBlock
                        Text="{Binding Direction}"
                        FontSize="11"
                        Foreground="#7F8CA3"/>
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Content="×"
                    Click="DismissButton_OnClick"
                    Padding="8,2"
                    Background="Transparent"
                    Foreground="#AEB9CD"
                    FontSize="18"/>
            </Grid>

            <Grid
                Grid.Row="1"
                Margin="0,14,0,0"
                ColumnDefinitions="*,10,Auto">
                <TextBox
                    x:Name="InputTextBox"
                    Text="{Binding InputText, Mode=TwoWay}"
                    PlaceholderText="Enter a word or short phrase"
                    Padding="11,8"
                    FontSize="15"/>
                <Button
                    Grid.Column="2"
                    Content="Translate"
                    Command="{Binding TranslateCommand}"
                    IsDefault="True"
                    Padding="14,8"
                    Background="#4F46E5"
                    Foreground="White"
                    FontWeight="SemiBold"/>
            </Grid>

            <StackPanel
                Grid.Row="2"
                Margin="0,10,0,0"
                Spacing="5">
                <ProgressBar
                    IsVisible="{Binding IsTranslating}"
                    IsIndeterminate="True"
                    Height="3"/>
                <TextBlock
                    Text="{Binding StatusMessage}"
                    TextWrapping="Wrap"
                    FontSize="11"
                    Foreground="#93A0B8"/>
            </StackPanel>

            <Grid
                Grid.Row="3"
                Margin="0,16,0,0"
                ColumnDefinitions="*,Auto,*"
                IsVisible="{Binding HasTranslation}">
                <TextBlock
                    Text="{Binding SourceText}"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    FontSize="18"
                    Foreground="#B8C2D6"/>

                <TextBlock
                    Grid.Column="1"
                    Margin="14,0"
                    VerticalAlignment="Center"
                    Text="→"
                    FontSize="18"
                    Foreground="#7C8AA3"/>

                <TextBlock
                    Grid.Column="2"
                    Text="{Binding TranslatedText}"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="White"/>
            </Grid>

            <Border
                Grid.Row="4"
                Margin="0,16,0,0"
                Padding="12"
                IsVisible="{Binding HasDictionaryDetails}"
                Background="#222D42"
                CornerRadius="10">
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="{Binding DictionarySource}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#8EA0BC"/>
                    <ScrollViewer MaxHeight="130">
                        <TextBlock
                            Text="{Binding DictionaryText}"
                            TextWrapping="Wrap"
                            Foreground="#E6EAF2"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
